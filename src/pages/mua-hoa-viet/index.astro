---
import { getCollection } from 'astro:content';
import ExploreLayout from '../../layouts/ExploreLayout.astro';
import MuaHoaViet from '../../explore/mua-hoa-viet/MuaHoaViet.svelte';
import { responsive, SIZES } from '../../explore/mua-hoa-viet/images';
import MapSvg from '../../explore/mua-hoa-viet/MapSvg.astro';
import { HEIGHT, toPercent, VIEWS_PCT, WIDTH } from '../../explore/mua-hoa-viet/map/projection';
import type { FlowerLite, PlaceLite } from '../../explore/mua-hoa-viet/types';

const flowers: FlowerLite[] = await Promise.all(
  (await getCollection('flowers')).map(async ({ data: f }) => {
    const photo = f.photos.find((p) => p.src);
    return {
      slug: f.slug,
      name: f.name,
      color: f.color,
      seasons: f.seasons,
      regions: f.regions,
      regionLabel: f.regionLabel,
      photo: photo?.src ? await responsive(photo.src, SIZES.card) : undefined,
      photoAlt: photo?.alt,
      places: f.places?.map((pf) => ({
        slug: pf.slug,
        best: typeof pf.best === 'string' ? pf.best : `T${pf.best.start.month} – T${pf.best.end.month}`,
      })),
    };
  }),
);

const places: PlaceLite[] = (await getCollection('places')).map(({ data: p }) => ({
  slug: p.slug,
  name: p.name,
  province: p.province,
  region: p.region,
  ...(p.lat != null && p.lng != null ? { lat: p.lat, lng: p.lng, ...toPercent(p.lat, p.lng) } : {}),
  maps_url: p.maps_url,
  flowers: p.flowers.map((pf) => ({
    slug: pf.slug,
    best: typeof pf.best === 'string' ? pf.best : `T${pf.best.start.month} – T${pf.best.end.month}`,
  })),
}));
---

<ExploreLayout
  slug="mua-hoa-viet"
  title="Mùa Hoa Việt"
  description="Hôm nay hoa gì đang nở? Xem mùa hoa cả năm trên bánh xe 12 tháng và chỗ ngắm hoa khắp Việt Nam."
>
  <MuaHoaViet client:load {flowers} {places} mapRatio={WIDTH / HEIGHT} mapViews={VIEWS_PCT} mapSize={[WIDTH, HEIGHT]}>
    <MapSvg label="Bản đồ Việt Nam, gồm quần đảo Hoàng Sa và Trường Sa, với các điểm ngắm hoa đang nở. Danh sách điểm ngắm ở bên cạnh." />
  </MuaHoaViet>
</ExploreLayout>
