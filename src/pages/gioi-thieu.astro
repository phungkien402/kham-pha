---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../config/site';
---

<BaseLayout
  title={`Giới thiệu · ${site.name}`}
  description="Khám Phá là nơi tập hợp những trang tương tác nhỏ về Việt Nam, mỗi trang một chủ đề, mở ngay trên trình duyệt."
>
  <main class="wrap">
    <a class="back" href="/">← Trang chủ</a>
    <h1>Giới thiệu</h1>
    <p>
      {site.name} là nơi tập hợp những trang khám phá tương tác nhỏ về Việt Nam. Mỗi trang một chủ đề,
      mở ra là chơi được ngay, không cần cài đặt hay đăng nhập.
    </p>
    <p>
      Trang đầu tiên sẽ là <strong>Mùa Hoa Việt</strong>: xem hôm nay hoa gì đang nở ở khắp các vùng miền.
    </p>
    <p>Web không dùng cookie và không thu thập dữ liệu cá nhân.</p>

    <section class="signup" aria-labelledby="dang-ky">
      <h2 id="dang-ky">Nhận tin khi có trang mới</h2>
      <form onsubmit="return false">
        <label for="email">Email của bạn</label>
        <div class="row">
          <input id="email" type="email" name="email" placeholder="ten@email.com" autocomplete="email" disabled />
          <button type="submit" disabled>Đăng ký</button>
        </div>
        <p class="hint">Tính năng đăng ký sẽ mở sau, hiện chưa gửi thông tin đi đâu.</p>
      </form>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 44rem;
    margin-inline: auto;
    padding: var(--space-4) var(--space-4) var(--space-12);
  }
  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
  }
  .back:focus-visible,
  input:focus-visible,
  button:focus-visible {
    outline: 3px solid var(--color-text);
    outline-offset: 2px;
  }
  h1 {
    font-size: 1.75rem;
  }
  h2 {
    font-size: 1.25rem;
  }
  .signup {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  label {
    font-size: 0.875rem;
    font-weight: 600;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  input {
    flex: 1 1 12rem;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    font: inherit;
  }
  button {
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 0;
    border-radius: 0.5rem;
    background: var(--color-text);
    color: #fff;
    font-weight: 600;
  }
  button:disabled,
  input:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .hint {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  @media (min-width: 768px) {
    .wrap {
      padding-inline: var(--space-6);
    }
    h1 {
      font-size: 2.25rem;
    }
  }
</style>
