---
import BaseLayout from './BaseLayout.astro';
import ShareButton from '../components/ShareButton.svelte';
import NextPage from '../components/NextPage.astro';
import { site } from '../config/site';
import pages from '../data/pages.json';

interface Props {
  slug: string;
  title: string;
  description?: string;
  ogImage?: string;
  /** Nút quay lại ở góc trên trái; mặc định về trang chủ. */
  back?: { href: string; label: string };
}

const { slug, title, description, ogImage, back = { href: '/', label: 'Trang chủ' } } = Astro.props;
// Trang draft vẫn build được để thử nhưng không được lập chỉ mục.
const noindex = pages.find((p) => p.slug === slug)?.status === 'draft';
---

<BaseLayout title={`${title} · ${site.name}`} description={description} ogImage={ogImage} noindex={noindex}>
  <header class="bar">
    <a class="back" href={back.href}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 18l-6-6 6-6" />
      </svg>
      <span>{back.label}</span>
    </a>
    <ShareButton client:idle title={title} text={description} />
  </header>
  <main class="content">
    <slot />
    <NextPage currentSlug={slug} />
  </main>
</BaseLayout>

<style>
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--space-3) var(--space-4);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    padding-right: var(--space-3);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
  }
  .back:focus-visible {
    outline: 3px solid var(--color-text);
    outline-offset: 2px;
    border-radius: 0.5rem;
  }
  .content {
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--space-4) var(--space-4) var(--space-12);
  }
  @media (min-width: 768px) {
    .bar,
    .content {
      padding-inline: var(--space-6);
    }
  }
</style>
