# Biến môi trường chạy thử local với `npx wrangler dev`
# Sao chép file này thành `.dev.vars` khi chạy trên máy.
# KHÔNG đặt DEV_BYPASS_AUTH trong wrangler.jsonc hoặc môi trường production.
DEV_BYPASS_AUTH=1
ACCESS_TEAM=your-team-name
ACCESS_AUD=your-access-aud-tag
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
IP_SALT=dev
